# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API Keys / Data API).
# Use a chave PUBLICÁVEL (sb_publishable_...). Nunca use a chave secret/service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
